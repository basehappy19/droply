{
  "name": "droproom",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev -w apps/server\" \"npm:dev -w apps/web\"",
    "build": "npm run build -w apps/server && npm run build -w apps/web",
    "start": "concurrently -n server,web \"npm:start -w apps/server\" \"npm:start -w apps/web\""
  },
  "devDependencies": { "concurrently": "^9.1.0" }
}
