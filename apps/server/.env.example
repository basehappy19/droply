# ---- DropRoom realtime/API server ----
PORT=4000
# Web origins allowed to call the API (comma separated). Use * only for local LAN testing.
CORS_ORIGIN=http://localhost:3000
REDIS_URL=redis://localhost:6379
# Long random string (e.g. `openssl rand -base64 48`). Required when NODE_ENV=production.
APP_SECRET=change-me
# Set true when running behind a reverse proxy (Nginx, Caddy, Cloudflare Tunnel) so rate limits see the real IP.
TRUST_PROXY=false
# Run the cleanup loop in this process. Set false if you run `npm run worker` separately.
INLINE_WORKER=true

# ---- File storage: local | s3 ----
STORAGE=local
LOCAL_STORAGE_DIR=./data/files
# Absolute public URL of this server, only needed if local-storage links must be absolute.
PUBLIC_URL=

# Cloudflare R2 / AWS S3 / MinIO (used when STORAGE=s3)
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=droproom
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true for MinIO
S3_FORCE_PATH_STYLE=false

# ---- WebRTC (direct P2P transfers) ----
STUN_URLS=stun:stun.l.google.com:19302,stun:stun.cloudflare.com:3478
# Optional TURN for networks where devices can't connect directly (e.g. coturn)
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# ---- Limits ----
MAX_FILE_MB=100
MAX_ROOM_MB=500
MAX_MEMBERS=50
EMPTY_GRACE_SEC=900
ROOMS_PER_HOUR=20
UPLOAD_MB_PER_DAY=2048
